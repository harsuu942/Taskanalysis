# --- DATABASE CONFIGURATION ---
# 1. Supabase PostgreSQL (Production / Vercel):
# In Supabase -> Project Settings -> Database -> Connection string:
# Session Pooler (Transaction Mode, Port 6543):
# DATABASE_URL="postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct Connection (Port 5432):
# DIRECT_URL="postgresql://postgres:[db-password]@db.[project-ref].supabase.co:5432/postgres"

# 2. Local Development with SQLite:
DATABASE_URL="file:./dev.db"

# --- SUPABASE STORAGE CONFIGURATION ---
# In Supabase -> Project Settings -> API:
# Project URL:
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
# Project Anon Key (public client operations):
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
# Service Role Key (secure server-side storage bucket uploads & administration):
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# --- GMAIL SMTP CONFIGURATION (OPTIONAL) ---
# Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
GMAIL_USER="your-email@gmail.com"
GMAIL_APP_PASSWORD="xxxx-xxxx-xxxx-xxxx"
ADMIN_NOTIFICATION_EMAIL="your-email@gmail.com"
PORT=3000
